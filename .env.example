# ── Orbit Search (apps/search) ────────────────────────────────────────────
# Serper.dev — Google results via API, free tier of 2,500 queries (https://serper.dev/api-keys).
# Serves Web, Images and News in Orbit Search. Keep this key server-side only; never put it in the browser or extension.
SERPER_API_KEY=
# Google Programmable Search — CLOSED to new customers (ends 2027-01-01); only useful if you already have one.
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
# Brave Search API (https://brave.com/search/api) — optional second backend
BRAVE_SEARCH_API_KEY=
# Which backend Orbit Search uses: serper | google | brave | orbit (default: first one configured, in that order)
ORBIT_SEARCH_BACKEND=
# Future Orbit Index service (see docs/orbit-index.md). Unset = not used.
ORBIT_INDEX_URL=
# Port for the local Orbit Search server
ORBIT_SEARCH_PORT=4400

# ── Browser (apps/browser) ────────────────────────────────────────────────
# URL of the Orbit Search page used when "Orbit Search" is the default provider.
ORBIT_SEARCH_URL=http://localhost:4400/orbit-search
# GitHub repo hosting releases (auto-update + publishing). Needed for `pnpm package` publishing only.
ORBIT_GH_OWNER=
ORBIT_GH_REPO=
GH_TOKEN=
# macOS signing / notarization (see docs/distribution.md)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=
# Windows signing certificate (see docs/distribution.md)
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# ── Website (apps/website) ────────────────────────────────────────────────
# owner/repo whose GitHub Releases back the download buttons. Unset = buttons say "not published yet".
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chrome Web Store listing URL for the extension. Unset = the "Add to Chrome" button is disabled.
NEXT_PUBLIC_CHROME_STORE_URL=
