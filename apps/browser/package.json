{
  "name": "@orbit/browser",
  "productName": "X Orbit",
  "version": "0.1.3",
  "description": "X Orbit \u2014 the web, reorbited.",
  "private": true,
  "main": "out/main/index.js",
  "author": "X Orbit",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "icons": "electron scripts/make-icons.cjs",
    "smoke": "node scripts/smoke.mjs",
    "package": "pnpm build && electron-builder --config electron-builder.config.cjs",
    "package:dir": "pnpm build && electron-builder --config electron-builder.config.cjs --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@orbit/search": "workspace:*",
    "@orbit/themes": "workspace:*",
    "@orbit/types": "workspace:*",
    "@orbit/ui": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  }
}
